# ---- palang-web build-time configuration (dotenv; the single config source) ----
#
# The variant is the Vite MODE (npm run build vs npm run build:app), not a var.
# Every VITE_* var here is optional — these are the documented defaults:
#
# VITE_HOST_URL  Official instance origin. Drives the privacy wording:
#                same origin -> "official instance" copy (with this URL),
#                any other remote origin -> third-party hosting copy,
#                localhost / file: -> your own copy.
#                Defaults to the production site when unset.
VITE_HOST_URL=https://palang.oh-alam.my
#
# Personal / environment-specific overrides go in gitignored files, loaded in
# this order (later wins):
#   .env                (shared, committed if you want; can hold secrets you
#                        keep out of git)
#   .env.local          (gitignored — YOUR overrides, e.g. a staging domain)
#   .env.development / .env.production / .env.app   (committed per-mode defaults)
#   .env.development.local / .env.production.local / .env.app.local
#                       (gitignored per-mode personal overrides)
#
# Runtime operator config lives separately in public/limits.json (no rebuild).
