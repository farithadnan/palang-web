{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Palang",
  "version": "0.2.9",
  "identifier": "my.faritadnan.palang",
  "build": {
    "beforeBuildCommand": "npm run build:app",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Palang — prepare documents for sharing",
        "width": 1080,
        "height": 780,
        "minWidth": 420,
        "minHeight": 620,
        "icon": [
          "icons/32x32.png",
          "icons/128x128.png",
          "icons/icon.ico"
        ]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Farith Adnan",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
